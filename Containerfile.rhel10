# hadolint ignore=DL3007
FROM registry.access.redhat.com/ubi10/ubi:latest AS builder

# Architecture
ARG ARCH=

ARG COLLECTL_GIT="https://github.com/sharkcz/collectl.git"
ARG COLLECTL_VER="4.3.20.1"
# This comes from the INSTALL script https://github.com/sharkcz/collectl/blob/master/INSTALL
ARG DESTDIR="/var/log/collectl"

# RPM versions
ARG HOSTNAME_VER="3.23-*"
ARG PCIUTILS_VER="3.13.*"
ARG GIT_VER="2.47.*"
# Also needed in RHEL10
ARG PERL_ENGLISH_VER="1.11-*"
ARG PROCPS_NG_VER="4.0.*"

ENV DESTDIR="${DESTDIR}"

USER 0

RUN dnf install --assumeyes \
      git-${GIT_VER} \
      hostname-${HOSTNAME_VER} \
      pciutils-${PCIUTILS_VER} \
      perl-English-${PERL_ENGLISH_VER} \
      procps-ng-${PROCPS_NG_VER} && \
    dnf clean all && \
    rm -rf /var/cache/dnf /usr/local/src/*

WORKDIR /usr/local/src/collectl

RUN git clone "${COLLECTL_GIT}" . && \
    ./INSTALL && \
    rm -rf ./*

WORKDIR ${DESTDIR}

# Ensure this works in RHOCP
# https://docs.redhat.com/en/documentation/openshift_container_platform/4.18/html/images/creating-images#use-uid_create-images
RUN chgrp -R 0 "${DESTDIR}" && \
    chmod -R g=u "${DESTDIR}"

COPY entrypoint.sh /usr/local/bin/entrypoint.sh

ENTRYPOINT ["entrypoint.sh"]

USER nobody
